{
  "requisicao": {
    "metodo": "GET",
    "caminho": "/api/v1/customers/{{contexto.cliente_id}}/receivables",
    "query": { "status": "open" }
  },
  "resposta": {
    "mapeamento": "{ \"titulos\": [receivables.{ \"titulo_id\": id, \"valor\": amount_cents / 100, \"vencimento\": due_date, \"link_pagamento\": pay_url }] }"
  }
}
