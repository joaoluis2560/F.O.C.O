{
  "openapi": "3.0.3",
  "info": {
    "title": "ERP Simulado",
    "version": "1.0.0",
    "description": "Fake business management API used for tests. Monetary values are integers in cents."
  },
  "servers": [{ "url": "http://127.0.0.1:8787" }],
  "security": [{ "bearer": [] }],
  "components": {
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "Customer": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "full_name": { "type": "string" },
          "phone": { "type": "string", "description": "Digits only, with country code" }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "sku": { "type": "string" },
          "title": { "type": "string" },
          "price_cents": { "type": "integer" },
          "unit": { "type": "string" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "number": { "type": "string" },
          "state": { "type": "string", "enum": ["pending", "shipped", "delivered", "cancelled"] },
          "total_cents": { "type": "integer" },
          "placed_at": { "type": "string", "format": "date" }
        }
      },
      "Receivable": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "amount_cents": { "type": "integer" },
          "due_date": { "type": "string", "format": "date" },
          "pay_url": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/customers": {
      "get": {
        "summary": "Find customers by exact phone number",
        "parameters": [
          { "name": "phone", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Matching customers (empty list when none)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Customer" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "summary": "Search products by title",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Matching products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Product" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products/{sku}/stock": {
      "get": {
        "summary": "Stock position of a product. Available quantity is on_hand minus reserved.",
        "parameters": [
          { "name": "sku", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Stock position",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sku": { "type": "string" },
                    "on_hand": { "type": "number" },
                    "reserved": { "type": "number" }
                  }
                }
              }
            }
          },
          "404": { "description": "Unknown product" }
        }
      }
    },
    "/api/v1/customers/{id}/orders": {
      "get": {
        "summary": "Orders of a customer",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orders": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Order" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/customers/{id}/receivables": {
      "get": {
        "summary": "Receivables (invoices) of a customer",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["open", "paid"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Receivables",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "receivables": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Receivable" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "post": {
        "summary": "Create an order. Supports the Idempotency-Key header.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer_id", "lines"],
                "properties": {
                  "customer_id": { "type": "string" },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["sku", "qty"],
                      "properties": {
                        "sku": { "type": "string" },
                        "qty": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created order",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Order" } }
            }
          },
          "422": { "description": "Invalid order" }
        }
      }
    }
  }
}
