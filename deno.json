{
  "tasks": {
    "verificar": "deno fmt --check && deno lint && deno check supabase/functions ferramentas piloto/preparar.ts piloto/verificar.ts piloto/implantar.ts && deno test --allow-net=127.0.0.1 --allow-read=. --allow-env",
    "segredos": "gitleaks git --redact --no-banner .",
    "banco": "supabase db reset && supabase db lint --level warning --fail-on warning && supabase test db",
    "erp-simulado": "deno run --allow-net=127.0.0.1 --allow-env --allow-read=. ferramentas/erp-simulado/servidor.ts",
    "construtor": "deno run --allow-net --allow-env --allow-read=. --allow-write=. ferramentas/construtor/cli.ts",
    "integracao": "FOCO_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres deno test --allow-net=127.0.0.1 --allow-read=. --allow-env supabase/functions/_shared/mcp/integracao_test.ts supabase/functions/_shared/atendimento/integracao_test.ts",
    "credencial": "deno run ferramentas/credencial.ts",
    "mcp-local": "FOCO_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres deno run --allow-net --allow-env --allow-read=. ferramentas/mcp_local.ts",
    "piloto:preparar": "FOCO_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres deno run --allow-net=127.0.0.1 --allow-env --allow-read=. --allow-write=piloto/hermes piloto/preparar.ts",
    "piloto:verificar": "deno run --allow-net=127.0.0.1 --allow-read=piloto/hermes piloto/verificar.ts",
    "simular": "FOCO_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres deno run --env-file=piloto/hermes/.env --allow-net --allow-env --allow-read=. ferramentas/simular_atendimento.ts",
    "simular:implantacao": "FOCO_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres deno run --env-file=piloto/hermes/.env --allow-net --allow-env --allow-read=. ferramentas/simular_implantacao.ts",
    "agendar:local": "FOCO_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres deno run --allow-net=127.0.0.1 --allow-env --allow-run=docker ferramentas/agendar_local.ts",
    "piloto:implantar": "FOCO_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres deno run --allow-net=127.0.0.1 --allow-env --allow-read=. --allow-write=piloto/hermes piloto/implantar.ts criar",
    "piloto:aprovar": "FOCO_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres deno run --allow-net=127.0.0.1 --allow-env --allow-read=. --allow-write=piloto/hermes piloto/implantar.ts aprovar"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@cfworker/json-schema": "npm:@cfworker/json-schema@^4.1.1",
    "jsonata": "npm:jsonata@^2.0.6",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.136.0",
    "@anthropic-ai/sdk/": "npm:/@anthropic-ai/sdk@^0.136.0/",
    "zod": "npm:zod@^4.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "postgres": "https://deno.land/x/postgresjs@v3.4.5/mod.js"
  },
  "fmt": {
    "include": [
      "supabase/functions/",
      "ferramentas/",
      "piloto/"
    ],
    "lineWidth": 100,
    "exclude": [
      "piloto/hermes/dados/"
    ]
  },
  "lint": {
    "include": [
      "supabase/functions/",
      "ferramentas/",
      "piloto/"
    ]
  },
  "test": {
    "include": [
      "supabase/functions/",
      "ferramentas/",
      "piloto/"
    ]
  }
}
